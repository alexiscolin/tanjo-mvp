# Admin Password for backoffice access
ADMIN_PASSWORD=your_admin_password_here

# Your Google Sheet ID (from the URL after /d/)
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Service account email (from JSON file)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com

# Private key (copy from service account JSON file)
# Format: full key with literal \n, wrapped in quotes
GOOGLE_PRIVATE_KEY="your_private_key_with_newlines_here"

# Exchange rate API URL (optional - public API)
# Default: https://open.er-api.com/v6/latest/JPY
NEXT_PUBLIC_EXCHANGE_RATE_API_URL=
